#!/sbin/sh
#
# AOSP Recovery Flashable Installer for HyperOS Camera (breeze)
# Compatible with AOSP Recovery, Lineage Recovery, Project Infinity-X Recovery, TWRP, and OrangeFox
#

OUTFD="/proc/self/fd/$2"
[ ! -e "$OUTFD" ] && OUTFD="/dev/null"
ZIP="$3"
[ -z "$ZIP" ] && ZIP="$1"

ui_print() {
  echo "ui_print $1" > "$OUTFD"
  echo "ui_print" > "$OUTFD"
}

set_con() {
  chcon -h u:object_r:"$1":s0 "$2" 2>/dev/null || true
  chcon u:object_r:"$1":s0 "$2" 2>/dev/null || true
}

is_mounted() {
  mountpoint -q "$1" 2>/dev/null || grep -q "[[:blank:]]$1[[:blank:]]" /proc/mounts 2>/dev/null
}

cleanup() {
  ui_print "- Unmounting partitions..."
  umount -l /mnt/odm 2>/dev/null || true
  umount -l /mnt/product 2>/dev/null || true
  umount -l /mnt/system_ext 2>/dev/null || true
  umount -l "$SYSTEM_MNT" 2>/dev/null || true
  umount -l /odm 2>/dev/null || true
  umount -l /product 2>/dev/null || true
  umount -l /system_ext 2>/dev/null || true
  rm -rf "$TMP/breeze_cam" 2>/dev/null || true
  rm -rf "$TMP/bin" 2>/dev/null || true
  rm -f "$TMP/toybox-arm64" 2>/dev/null || true
}

error() {
  ui_print "Error: $1"
  cleanup
  exit 1
}

ui_print "============================================"
ui_print " HyperOS Camera for breeze (AOSP Recovery) "
ui_print "   Redmi 13 5G / POCO M6 Plus 5G (SM4450)  "
ui_print "============================================"

TMP="/tmp"
cd "$TMP" || exit 1

# Extract toybox for full POSIX tooling in AOSP Recovery
ui_print "- Setting up AOSP recovery environment..."
unzip -o "$ZIP" "toybox-arm64" >/dev/null 2>&1
TOYBOX="${TMP}/toybox-arm64"
chmod +x "$TOYBOX" 2>/dev/null

if [ -f "$TOYBOX" ]; then
  TOYS_PATH="${TMP}/bin"
  rm -rf "$TOYS_PATH"
  mkdir -p "$TOYS_PATH"
  $TOYBOX install -d "$TOYS_PATH" 2>/dev/null || true
  for toy in $($TOYBOX 2>/dev/null); do
    $TOYBOX ln -sf "$TOYBOX" "${TOYS_PATH}/${toy}" 2>/dev/null || true
  done
  PATH="${TOYS_PATH}:${PATH}"
fi

# Locate Dynamic Partitions
DYNAMIC_PARTITIONS=$(getprop ro.boot.dynamic_partitions)
if [ "$DYNAMIC_PARTITIONS" = "true" ] || [ -d "/dev/block/mapper" ]; then
  DYNAMIC_PARTITIONS="true"
  BLK_PATH="/dev/block/mapper"
else
  BLK_PATH="/dev/block/bootdevice/by-name"
fi

SLOT_SUFFIX=$(getprop ro.boot.slot_suffix)
[ -z "$SLOT_SUFFIX" ] && SLOT_SUFFIX="_a"

get_block_for_mount_point() {
  [ -f /etc/recovery.fstab ] && grep -v "^#" /etc/recovery.fstab | grep "[[:blank:]]$1[[:blank:]]" | tail -n1 | tr -s [:blank:] ' ' | cut -d' ' -f1
}

find_block() {
  local name="$1"
  local fstab_entry=""
  [ -f /etc/recovery.fstab ] && fstab_entry=$(get_block_for_mount_point "/$name")
  [ -z "$fstab_entry" ] && [ "$name" = "system" ] && [ -f /etc/recovery.fstab ] && fstab_entry=$(get_block_for_mount_point "/")
  [ -z "$fstab_entry" ] && [ "$name" = "system" ] && [ -f /etc/recovery.fstab ] && fstab_entry=$(get_block_for_mount_point "/system_root")

  local dev
  if [ "$DYNAMIC_PARTITIONS" = "true" ]; then
    if [ -n "$fstab_entry" ]; then
      dev="${BLK_PATH}/${fstab_entry}${SLOT_SUFFIX}"
    else
      dev="${BLK_PATH}/${name}${SLOT_SUFFIX}"
    fi
  else
    if [ -n "$fstab_entry" ]; then
      dev="${fstab_entry}${SLOT_SUFFIX}"
    else
      dev="${BLK_PATH}/${name}${SLOT_SUFFIX}"
    fi
  fi

  if [ -b "$dev" ]; then
    echo "$dev"
  elif [ -b "${BLK_PATH}/${name}" ]; then
    echo "${BLK_PATH}/${name}"
  elif [ -n "$fstab_entry" ] && [ -b "$fstab_entry" ]; then
    echo "$fstab_entry"
  fi
}

SYSTEM_BLOCK=$(find_block "system")
PRODUCT_BLOCK=$(find_block "product")
SYSTEM_EXT_BLOCK=$(find_block "system_ext")
ODM_BLOCK=$(find_block "odm")

ui_print "- Active Slot: ${SLOT_SUFFIX}"
ui_print "- Mounting partitions..."

# Unmount beforehand to avoid busy errors
umount -l /system 2>/dev/null || umount -l /mnt/system 2>/dev/null || true
umount -l /product 2>/dev/null || true
umount -l /system_ext 2>/dev/null || true
umount -l /odm 2>/dev/null || true

# Disable read-only block device protection
if [ "$DYNAMIC_PARTITIONS" = "true" ]; then
  [ -n "$SYSTEM_BLOCK" ] && blockdev --setrw "$SYSTEM_BLOCK" 2>/dev/null || true
  [ -n "$PRODUCT_BLOCK" ] && blockdev --setrw "$PRODUCT_BLOCK" 2>/dev/null || true
  [ -n "$SYSTEM_EXT_BLOCK" ] && blockdev --setrw "$SYSTEM_EXT_BLOCK" 2>/dev/null || true
  [ -n "$ODM_BLOCK" ] && blockdev --setrw "$ODM_BLOCK" 2>/dev/null || true
fi

SYSTEM_MNT="/mnt/system"
mkdir -p "$SYSTEM_MNT"
if ! mount -o rw "$SYSTEM_BLOCK" "$SYSTEM_MNT" 2>/dev/null; then
  mount "$SYSTEM_BLOCK" "$SYSTEM_MNT" 2>/dev/null || error "Could not mount system partition!"
fi

SYSTEM_OUT="${SYSTEM_MNT}/system"
[ ! -d "$SYSTEM_OUT" ] && SYSTEM_OUT="$SYSTEM_MNT"

# Mount product, system_ext, odm under /mnt (always writable tmpfs in recovery)
TARGET_PRODUCT="${SYSTEM_OUT}/product"
if [ -n "$PRODUCT_BLOCK" ] && [ -b "$PRODUCT_BLOCK" ]; then
  mkdir -p /mnt/product
  if mount -o rw "$PRODUCT_BLOCK" /mnt/product 2>/dev/null || mount "$PRODUCT_BLOCK" /mnt/product 2>/dev/null; then
    TARGET_PRODUCT="/mnt/product"
    ui_print "- Mounted product to /mnt/product"
  fi
fi

TARGET_SYSTEM_EXT="${SYSTEM_OUT}/system_ext"
if [ -n "$SYSTEM_EXT_BLOCK" ] && [ -b "$SYSTEM_EXT_BLOCK" ]; then
  mkdir -p /mnt/system_ext
  if mount -o rw "$SYSTEM_EXT_BLOCK" /mnt/system_ext 2>/dev/null || mount "$SYSTEM_EXT_BLOCK" /mnt/system_ext 2>/dev/null; then
    TARGET_SYSTEM_EXT="/mnt/system_ext"
    ui_print "- Mounted system_ext to /mnt/system_ext"
  fi
fi

TARGET_ODM="${SYSTEM_OUT}/odm"
if [ -n "$ODM_BLOCK" ] && [ -b "$ODM_BLOCK" ]; then
  mkdir -p /mnt/odm
  if mount -o rw "$ODM_BLOCK" /mnt/odm 2>/dev/null || mount "$ODM_BLOCK" /mnt/odm 2>/dev/null; then
    TARGET_ODM="/mnt/odm"
    ui_print "- Mounted odm to /mnt/odm"
  fi
fi

# Extract proprietary camera components
ui_print "- Extracting camera components..."
EXTRACT_DIR="${TMP}/breeze_cam"
rm -rf "$EXTRACT_DIR"
mkdir -p "$EXTRACT_DIR"
unzip -o "$ZIP" "proprietary/*" -d "$EXTRACT_DIR" >/dev/null 2>&1

SRC="$EXTRACT_DIR/proprietary"

# 1. Product partition (MiuiCamera, breeze.xml, permissions, JNI libs)
ui_print "- Installing MiuiCamera & 108MP device features to ${TARGET_PRODUCT}..."
mkdir -p "$TARGET_PRODUCT/priv-app/MiuiCamera/lib/arm64"
mkdir -p "$TARGET_PRODUCT/lib64"
mkdir -p "$TARGET_PRODUCT/etc/device_features"
mkdir -p "$TARGET_PRODUCT/etc/permissions"

cp -af "$SRC/product/priv-app/MiuiCamera/MiuiCamera.apk" "$TARGET_PRODUCT/priv-app/MiuiCamera/"
cp -af "$SRC/system_ext/lib64/"* "$TARGET_PRODUCT/priv-app/MiuiCamera/lib/arm64/"
cp -af "$SRC/system_ext/lib64/"* "$TARGET_PRODUCT/lib64/"
cp -af "$SRC/product/etc/device_features/"* "$TARGET_PRODUCT/etc/device_features/"
cp -af "$SRC/product/etc/permissions/"* "$TARGET_PRODUCT/etc/permissions/"

# 2. System_ext partition (Framework jars, algo libraries, permissions)
ui_print "- Installing Xiaomi framework dependencies & algorithms to ${TARGET_SYSTEM_EXT}..."
mkdir -p "$TARGET_SYSTEM_EXT/framework"
mkdir -p "$TARGET_SYSTEM_EXT/lib64"
mkdir -p "$TARGET_SYSTEM_EXT/etc/permissions"

cp -af "$SRC/system_ext/framework/"* "$TARGET_SYSTEM_EXT/framework/"
cp -af "$SRC/system_ext/lib64/"* "$TARGET_SYSTEM_EXT/lib64/"
cp -af "$SRC/system_ext/etc/permissions/"* "$TARGET_SYSTEM_EXT/etc/permissions/"
cp -af "$SRC/system_ext/etc/"*.json "$TARGET_SYSTEM_EXT/etc/" 2>/dev/null || true

# 3. ODM partition (Camera booster JSONs)
ui_print "- Installing ODM camera boosters to ${TARGET_ODM}..."
mkdir -p "$TARGET_ODM/etc/camera"
cp -af "$SRC/odm/etc/camera/"* "$TARGET_ODM/etc/camera/"

# 4. Patch public.libraries.txt to expose system libraries to MiuiCamera linker namespace
ui_print "- Configuring linker public libraries..."
for pub in "${SYSTEM_OUT}/etc/public.libraries.txt" "${TARGET_PRODUCT}/etc/public.libraries.txt"; do
  if [ -f "$pub" ]; then
    for lib in \
      libbinder.so \
      libcamera_client.so \
      libcamera_metadata.so \
      libcutils.so \
      libgui.so \
      libutils.so \
      libvndksupport.so \
      libandroid_runtime.so \
      libbase.so \
      libmedia_jni_utils.so \
      libui.so \
      android.hidl.token@1.0-utils.so \
      libc++.so \
      libcrypto.so \
      libxml2.so \
      libopencl-camera.so \
      libcamera_algoup_jni.xiaomi.so \
      libcamera_mianode_jni.xiaomi.so \
      libcameraimpl.so \
      libcameramind.so; do
      if ! grep -q "^$lib" "$pub"; then
        echo "$lib" >> "$pub"
      fi
    done
    chmod 644 "$pub" 2>/dev/null || true
    chown root:root "$pub" 2>/dev/null || true
    chcon -h u:object_r:system_file:s0 "$pub" 2>/dev/null || true
  fi
done

# 4. Set permissions & SELinux contexts
ui_print "- Setting file permissions & SELinux contexts..."
for p in "$TARGET_PRODUCT/priv-app/MiuiCamera" "$TARGET_PRODUCT/lib64" "$TARGET_PRODUCT/etc/device_features" "$TARGET_SYSTEM_EXT/framework" "$TARGET_SYSTEM_EXT/lib64" "$TARGET_ODM/etc/camera"; do
  find "$p" -type d -exec chmod 755 {} + 2>/dev/null || true
  find "$p" -type f -exec chmod 644 {} + 2>/dev/null || true
  find "$p" -exec chown root:root {} + 2>/dev/null || true
  find "$p" -exec chcon -h u:object_r:system_file:s0 {} + 2>/dev/null || true
done

# 5. Install addon.d survival script
ui_print "- Installing OTA survival script (addon.d)..."
mkdir -p "${SYSTEM_OUT}/addon.d"
ADDOND_SCRIPT="${SYSTEM_OUT}/addon.d/70-miuicamera.sh"
unzip -o "$ZIP" "addon.d/70-miuicamera.sh" -d "$TMP" >/dev/null 2>&1
if [ -f "$TMP/addon.d/70-miuicamera.sh" ]; then
  cp -af "$TMP/addon.d/70-miuicamera.sh" "$ADDOND_SCRIPT"
fi
chmod 755 "$ADDOND_SCRIPT" 2>/dev/null || true
chown root:root "$ADDOND_SCRIPT" 2>/dev/null || true
chcon -h u:object_r:system_file:s0 "$ADDOND_SCRIPT" 2>/dev/null || true

cleanup
ui_print "============================================"
ui_print " Installation Successful!                   "
ui_print " 108MP & Aux camera features enabled.      "
ui_print " Camera will survive future OTA updates.   "
ui_print "============================================"
exit 0
