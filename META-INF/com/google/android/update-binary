#!/sbin/sh
##########################################################################################
# Universal Recovery Flashable + Magisk Module Installer
# Compatible with OrangeFox Recovery, TWRP, Magisk, KernelSU, and APatch
##########################################################################################

OUTFD=$2
ZIPFILE=$3

[ -z "$OUTFD" ] && OUTFD=1
[ -z "$ZIPFILE" ] && ZIPFILE="$1"

ui_print() {
    echo -e "ui_print $1\nui_print" >&$OUTFD
}

ui_print "********************************************************"
ui_print "*      HyperOS Camera for breeze / breeze_in           *"
ui_print "*    Redmi 13 5G / POCO M6 Plus 5G (Snapdragon 4 Gen 2)*"
ui_print "*           Universal Recovery Flashable               *"
ui_print "********************************************************"

# Detect Environment
MODID="hyperos_camera_breeze"
MODPATH="/data/adb/modules/$MODID"

ui_print "- Mounting partitions..."
mount /data 2>/dev/null
mount -o rw /data 2>/dev/null

if [ ! -d "/data/adb" ]; then
    mkdir -p /data/adb/modules
fi

ui_print "- Preparing module path: $MODPATH"
rm -rf "$MODPATH"
mkdir -p "$MODPATH"

# Extract zip contents into MODPATH
ui_print "- Extracting camera components..."
if command -v unzip >/dev/null 2>&1; then
    unzip -o "$ZIPFILE" -x "META-INF/*" -d "$MODPATH" >/dev/null 2>&1
else
    # Fallback to current directory if running inside Magisk installer
    cp -af ./* "$MODPATH/" 2>/dev/null
fi

# Set proper permissions
ui_print "- Setting permissions..."
chmod -R 755 "$MODPATH"
find "$MODPATH/system" -type f -exec chmod 644 {} + 2>/dev/null
chmod 755 "$MODPATH/service.sh" 2>/dev/null
chmod 755 "$MODPATH/post-fs-data.sh" 2>/dev/null

# Try mounting system rw if possible (for non-EROFS ROMs)
mount -o rw,remount /system 2>/dev/null
mount -o rw,remount /product 2>/dev/null

if [ -w "/product" ]; then
    ui_print "- Writable system detected: Injecting directly into /product & /system..."
    cp -rf "$MODPATH/system/"* / 2>/dev/null
fi

# Touch update flag for Magisk/KernelSU
touch "$MODPATH/update"
rm -f "$MODPATH/disable"
rm -f "$MODPATH/remove"

ui_print "********************************************************"
ui_print "*   Installation Complete!                             *"
ui_print "*   Camera features & 108MP support ready for breeze   *"
ui_print "*   Reboot and enjoy your HyperOS Camera!              *"
ui_print "********************************************************"

exit 0
