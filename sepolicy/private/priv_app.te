# Allow privileged camera app to bind to camera provider and postproc
allow priv_app hal_camera_default:binder { call transfer };
allow priv_app vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;
allow priv_app hal_camera_hwservice:hwservice_manager find;
allow priv_app vendor_default_prop:file { read open getattr };
