hal_client_domain(priv_app, vendor_hal_camerapostproc_xiaomi)

binder_use(priv_app)
binder_call(priv_app, vendor_hal_camerapostproc_xiaomi)
binder_call(priv_app, hal_camera_default)
allow priv_app hal_camera_default:fd use;
allow priv_app vendor_camera_data_file:dir { append map r_dir_perms write };
allow priv_app vendor_camera_data_file:file { getattr open read };
get_prop(priv_app, vendor_camera_sensor_prop)
